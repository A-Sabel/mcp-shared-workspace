# Copy to .env and fill in.
# Never commit .env.

# Live workspace: a directory OUTSIDE this repository.
# The workspace should have its own Git repository.
WORKSPACE_ROOT=C:\path\to\mcp-workspace

# Generate each with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
READER_TOKEN=change-me-reader
WRITER_TOKEN=change-me-writer

# Public HTTPS hostname used by ngrok. Use the hostname only, without https://.
PUBLIC_HOSTNAME=your-subdomain.ngrok-free.dev

# JSONL audit log
LOG_PATH=logs/tool_calls.jsonl